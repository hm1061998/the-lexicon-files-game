        },
        {
          "id": "chat_confirmation",
          "speakerId": "anna",
          "text": "Yes, I confirmed 14 Bridge Street in the chat. Leo asked me to check the address, and I replied before the courier arrived.",
          "translationVi": "Đúng, tôi xác nhận 14 Bridge Street trong tin nhắn. Leo nhờ tôi kiểm tra địa chỉ và tôi trả lời trước khi người chuyển phát đến.",
          "vocabularySpans": [
