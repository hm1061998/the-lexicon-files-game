              "type": "setFlag",
              "key": "leo_desk_statement_read",
              "value": true
            }
          ]
        },
        {
          "id": "unfinished_sample",
          "speakerId": "leo",
          "text": "The client wanted the sample today. I still had some work to finish, but the courier schedule had already been agreed.",
          "translationVi": "Khách hàng muốn phần mẫu trong hôm nay. Tôi vẫn còn việc phải làm cho xong, nhưng lịch trình chuyển phát đã được thống nhất.",
          "vocabularySpans": [
            {
              "start": 4,
              "end": 10,
              "vocabularyId": "client"
            },
