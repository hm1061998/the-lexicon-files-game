              "value": true
            }
          ]
        },
        {
          "id": "delivery_schedule",
          "speakerId": "anna",
          "text": "The courier was due at 17:00. The client needed the package before 17:30. It was urgent, so I checked the number carefully.",
          "translationVi": "Người chuyển phát dự kiến đến lúc 17:00. Khách hàng cần gói hàng trước 17:30. Việc này gấp nên tôi kiểm tra số nhà cẩn thận.",
          "vocabularySpans": [
            {
              "start": 4,
              "end": 11,
              "vocabularyId": "courier"
            },
