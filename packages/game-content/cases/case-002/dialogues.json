              ]
            }
          ],
          "effects": [
            {
              "type": "setFlag",
              "key": "leo_sample_read",
              "value": true
            }
          ]
        },
        {
          "id": "blame_anna",
          "speakerId": "leo",
          "text": "All right, I went in briefly. Anna wrote the wrong house number on the label. The address was her responsibility.",
          "translationVi": "Được rồi, tôi có vào một lúc. Anna viết sai số nhà trên nhãn. Địa chỉ là trách nhiệm của cô ấy.",
