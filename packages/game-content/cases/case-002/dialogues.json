                  "type": "setFlag",
                  "key": "david_request_question_done",
                  "value": true
                }
              ]
            }
          ],
          "effects": [
            {
              "type": "setFlag",
              "key": "david_early_request_read",
              "value": true
            }
          ]
        },
        {
          "id": "request_reason",
          "speakerId": "david",
          "text": "It was an urgent delivery for the client. I wanted to check that the package was ready. I waited instead of changing the schedule.",
          "translationVi": "Đó là chuyến giao hàng gấp cho khách hàng. Tôi muốn kiểm tra gói hàng đã sẵn sàng. Tôi chờ thay vì đổi lịch trình.",
          "vocabularySpans": [
