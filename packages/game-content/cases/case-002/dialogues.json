    {
      "id": "david_delivery",
      "npcId": "david",
      "entryNodeId": "entry",
      "nodes": [
        {
          "id": "entry",
          "speakerId": "david",
          "text": "I was at reception when we were waiting for the delivery. Please ask what you need.",
          "translationVi": "Tôi ở quầy tiếp tân khi chúng tôi chờ chuyến giao hàng. Bạn cứ hỏi điều cần biết.",
          "terminal": false,
          "choices": [
            {
              "id": "ask_early",
              "text": "When did you ask for the package?",
              "translationVi": "Bạn hỏi lấy gói hàng lúc nào?",
              "nextNodeId": "early_request"
            },
            {
              "id": "ask_reason",
              "text": "Why did you want it early?",
              "translationVi": "Vì sao bạn muốn lấy sớm?",
              "nextNodeId": "request_reason"
            }
          ]
        },
        {
          "id": "early_request",
          "speakerId": "david",
          "text": "I asked for the package early, at 16:25. Anna told me to wait for the courier at 17:00. I stayed at reception; I did not enter the mail room.",
          "translationVi": "Tôi hỏi lấy gói hàng sớm, lúc 16:25. Anna bảo tôi chờ người chuyển phát đến lúc 17:00. Tôi ở quầy tiếp tân, không vào phòng thư.",
          "vocabularySpans": [
            {
              "start": 16,
              "end": 23,
              "vocabularyId": "package"
            },
            {
              "start": 24,
              "end": 29,
              "vocabularyId": "early"
            },
            {
              "start": 70,
              "end": 77,
              "vocabularyId": "courier"
            }
          ],
          "terminal": false,
