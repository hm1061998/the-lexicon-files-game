    {
      "id": "leo_delivery",
      "npcId": "leo",
      "entryNodeId": "entry",
      "nodes": [
        {
          "id": "entry",
          "speakerId": "leo",
          "text": "I worked on the sample for this delivery. What do you want to know?",
          "translationVi": "Tôi làm phần mẫu cho chuyến giao hàng này. Bạn muốn biết điều gì?",
          "terminal": false,
          "choices": [
            {
              "id": "ask_whereabouts",
              "text": "Where were you this afternoon?",
              "translationVi": "Chiều nay bạn ở đâu?",
              "nextNodeId": "desk_statement"
            },
            {
              "id": "ask_work",
              "text": "Was your sample ready for the client?",
              "translationVi": "Phần mẫu của bạn đã sẵn sàng cho khách hàng chưa?",
              "nextNodeId": "unfinished_sample"
            },
            {
              "id": "challenge_log",
              "text": "The access log shows you entered the mail room at 16:40. Why?",
              "translationVi": "Nhật ký ghi bạn vào phòng thư lúc 16:40. Vì sao?",
              "nextNodeId": "blame_anna",
              "condition": {
                "type": "all",
                "conditions": [
                  {
                    "type": "hasEvidence",
                    "evidenceId": "mailroom_access_log"
                  },
                  {
                    "type": "flag",
                    "key": "leo_desk_statement_read",
                    "value": true
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "desk_statement",
          "speakerId": "leo",
          "text": "I was at my desk all afternoon. I did not go into the mail room.",
          "translationVi": "Tôi ở bàn làm việc cả chiều. Tôi không vào phòng thư.",
          "vocabularySpans": [],
          "terminal": false,
          "choices": [
            {
              "id": "continue",
              "text": "Continue asking",
              "translationVi": "Tiếp tục hỏi",
