    {
      "id": "anna_delivery",
      "npcId": "anna",
      "entryNodeId": "entry",
      "nodes": [
        {
          "id": "entry",
          "speakerId": "anna",
          "text": "I prepared the delivery for Harper & Co. What would you like to check?",
          "translationVi": "Tôi chuẩn bị chuyến giao hàng cho Harper & Co. Bạn muốn kiểm tra điều gì?",
          "terminal": false,
          "choices": [
            {
              "id": "check_address",
              "text": "What address did you check at 16:10?",
              "translationVi": "Bạn kiểm tra địa chỉ nào lúc 16:10?",
              "nextNodeId": "checked_address"
            },
            {
              "id": "ask_schedule",
              "text": "What was the delivery schedule?",
              "translationVi": "Lịch trình giao hàng thế nào?",
              "nextNodeId": "delivery_schedule"
            },
            {
              "id": "confirm_chat",
              "text": "Your message says 14. Can you confirm that?",
              "translationVi": "Tin nhắn của bạn ghi số 14. Bạn xác nhận được không?",
              "nextNodeId": "chat_confirmation",
              "condition": {
                "type": "hasEvidence",
                "evidenceId": "chat_messages"
              }
            }
          ]
        },
        {
          "id": "checked_address",
          "speakerId": "anna",
          "text": "I checked the address when I signed the package into the mail room at 16:10. It was 14 Bridge Street.",
          "translationVi": "Tôi kiểm tra địa chỉ khi ký nhận gói hàng vào phòng thư lúc 16:10. Địa chỉ là 14 Bridge Street.",
          "vocabularySpans": [
            {
              "start": 14,
              "end": 21,
              "vocabularyId": "address"
            },
            {
              "start": 29,
              "end": 35,
              "vocabularyId": "sign"
            },
            {
              "start": 40,
