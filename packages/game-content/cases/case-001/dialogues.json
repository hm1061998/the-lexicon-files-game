          },
          "terminal": false,
          "choices": [
            {
              "id": "q1",
              "text": "Where were you?",
              "nextNodeId": "answer1"
            },
            {
              "id": "q2",
              "text": "Did you see the report?",
              "nextNodeId": "answer2"
            },
