      "nodes": [
        {
          "id": "entry",
          "speakerId": "anna",
          "text": "I left the meeting early. I had a call with a client.",
          "audio": {
            "url": "/audio/case-001/anna/anna_initial__entry.wav",
            "textSha256": "1f51da8b0a6316e71017325a7ea55e27c392ae6356ec02442f81b2a4e72ff47d"
          },
          "translationVi": "Tôi rời cuộc họp sớm. Tôi có cuộc gọi với một khách hàng.",
          "vocabularySpans": [
            {
              "start": 2,
              "end": 6,
              "vocabularyId": "leave"
            },
            {
              "start": 11,
              "end": 18,
              "vocabularyId": "meeting"
            },
            {
              "start": 19,
              "end": 24,
              "vocabularyId": "early"
            },
            {
              "start": 46,
              "end": 52,
              "vocabularyId": "client"
            }
          ],
          "terminal": false,
          "choices": [
            {
              "id": "q1",
              "text": "What time did you leave?",
              "translationVi": "Bạn rời đi lúc mấy giờ?",
              "nextNodeId": "answer1"
            },
            {
              "id": "q2",
              "text": "Did you return later?",
              "translationVi": "Sau đó bạn có quay lại không?",
              "nextNodeId": "answer2"
            },
            {
              "id": "q3",
              "text": "Who was still in the room?",
              "translationVi": "Ai vẫn còn ở trong phòng?",
              "nextNodeId": "answer3"
            }
          ]
        },
        {
          "id": "answer1",
          "speakerId": "anna",
          "text": "A little after eight fifteen.",
          "audio": {
            "url": "/audio/case-001/anna/anna_initial__answer1.wav",
            "textSha256": "62ee9f954a6ae9477b2aa5eeb760619c03edc2d0bfe7ef5177ff55570c548390"
          },
          "terminal": false,
          "choices": [
            {
              "id": "continue",
              "text": "Tiếp tục hỏi",
              "nextNodeId": "entry",
              "effects": [
                {
                  "type": "setFlag",
                  "key": "anna_q1_read",
                  "value": true
                }
              ]
            }
          ]
        },
        {
          "id": "answer2",
          "speakerId": "anna",
          "text": "No. I went directly to my desk.",
          "audio": {
            "url": "/audio/case-001/anna/anna_initial__answer2.wav",
            "textSha256": "c4eaeb5adba9a1219c34520613e3bc479a20af7f2f0bbb24e24b1fe2f33d1163"
