{
  "name": "the-lexicon-files",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["apps/game-web", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @lexicon/game-web",
    "build": "npm run build -w @lexicon/game-web",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @lexicon/game-web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
